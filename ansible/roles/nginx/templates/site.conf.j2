server {
    listen 80;
    server_name {{ domain }};

    return 301 https://{{ domain }}$request_uri;
}

server {
    listen {{ nginx_host }}:{{ nginx_port }} ssl;
    http2 on;

    server_name {{ domain }};

    ssl_certificate {{ nginx_ssl_certificate }};
    ssl_certificate_key {{ nginx_ssl_certificate_key }};

    ssl_protocols {{ nginx_ssl_protocols | join(' ') }};
    ssl_session_cache {{ nginx_ssl_session_cache }};
    ssl_session_timeout {{ nginx_ssl_session_timeout }};
    ssl_session_tickets {{ 'on' if nginx_ssl_session_tickets else 'off' }};

    root {{ nginx_web_root }};
    index index.html;

    client_max_body_size {{ nginx_client_max_body_size }};

    access_log /var/log/nginx/{{ domain }}.access.log main;
    error_log /var/log/nginx/{{ domain }}.error.log warn;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|mjs|css|woff2|png|jpg|jpeg|gif|webp|svg|ico|avif)$ {
        expires 1y;

        add_header Cache-Control "public, max-age=31536000, immutable";

        try_files $uri =404;

        access_log off;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://{{ app.host }}:{{ app.port }};

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /files/ {
        alias {{ nginx_files_root }}/;
    }

    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/500.html;
}